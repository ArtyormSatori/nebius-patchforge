# Nebius Token Factory API Configuration
# Get your API key from https://tokenfactory.nebius.com/ or https://dev.nebius.com/builders
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=your_nebius_token_factory_key

# NVIDIA Models on Nebius Token Factory
# Ultra for complex architectural root-cause synthesis; Nano for fast linting/triage
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-ultra
NEBIUS_MODEL_FAST=nvidia/nemotron-nano

# Tavily Search API (Eligible for $3,000 Best Use of Tavily Bonus Award)
# Get your API key from https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# Web Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
